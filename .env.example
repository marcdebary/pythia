# ===========================================================================
#  Pythia — Konfiguration. Nach .env kopieren und ausfuellen.
#
#  Diese Software HANDELT NICHT. Die Methoden zum Aufgeben und Stornieren von
#  Orders sind aus dem Boersenklienten entfernt, nicht bloss abgeschaltet. Es
#  gibt hier keinen Schalter, der das aendert.
#
#  Die eigene .env gehoert niemals ins Versionsverwaltungssystem.
# ===========================================================================

# --- Kalshi (Leserechte genuegen) -----------------------------------------
#  kalshi.com -> Settings -> API. RSA-Schluesselpaar erzeugen, den oeffentlichen
#  Teil dort hinterlegen, den privaten als PEM unter dem Pfad unten ablegen.
#  Ohne diese Angaben laeuft alles, was keine Anmeldung braucht.
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/data/kalshi_private.pem
KALSHI_DEMO=0

# --- Buchmacher-Referenz fuer Sport ---------------------------------------
#  the-odds-api.com. Der kostenlose Tarif umfasst 500 Abrufeinheiten im Monat;
#  ein Abruf je Sportart kostet zwei. Ohne Schluessel bleibt der Sportteil aus,
#  der Wetterteil laeuft weiter.
ODDS_API_KEY=
ODDS_API_MONTHLY_QUOTA=500

# --- Was gesammelt wird ---------------------------------------------------
SPORT_SAMMELN=1
SPORTARTEN=baseball_mlb,basketball_wnba,soccer_usa_mls
SPORT_INTERVALL_SEK=300

#  Wetter kostet nichts. Der National Weather Service und Open-Meteo sind frei
#  und ohne Schluessel.
WETTER_SAMMELN=1
WETTER_INTERVALL_SEK=900

# --- Betrieb --------------------------------------------------------------
PYTHIA_PORT=8300
LOG_LEVEL=INFO
PULS_INTERVALL_SEK=3600

# --- Darstellung ----------------------------------------------------------
#  Ab dieser Abweichung wird eine Zeile als verdaechtig markiert. Gegen einen
#  Markt mit sechsstelligem Tagesumsatz ist der eigene Modellfehler
#  wahrscheinlicher als ein Fehler des Marktes.
VERDACHT_PP=15
HINWEIS_MAX_ALTER_SEK=10800
